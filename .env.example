# ===== Entorno de Artemisa — EJEMPLO (copia a `.env` y ajusta) =====
# UN SOLO settings.py: todo lo que cambia entre máquinas y entornos sale de
# aquí. Este archivo NO va a git; su espejo con valores de ejemplo es
# `.env.example`. Tras editarlo: `docker compose up -d` (recrear).

# --- Seguridad ---
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True
ALLOWED_HOSTS=*

# HOT RELOAD en Docker: 1 = el web corre runserver y se recarga al guardar.
# 0 = gunicorn (lo que iría en un servidor de verdad).
DEV=1

# --- Sitio ---
SITE_NAME=Frikiverso
TIME_ZONE=America/Santiago

# --- Base de datos: el Postgres del stack ---
# Dentro del compose mandan sus valores (DB_HOST=db, DB_PORT=5432). Los de
# aquí son para el `runserver` local, que entra por el puerto publicado.
# Si falta DB_NAME, Django cae a sqlite y aparece un db.sqlite3 fantasma.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=artemisa
DB_USER=artemisa
DB_PASSWORD=artemisa
DB_HOST=localhost
DB_PORT=55432
DB_PORT_HOST=55432   # puerto publicado al host (55432 para no chocar
                              # con un Postgres instalado en Windows)

# --- Puertos publicados ---
WEB_PORT=8000                # el sitio, por nginx
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@frikiverso.cl
PGADMIN_PASSWORD=admin
DOZZLE_PORT=8888             # logs de los contenedores (solo en localhost)
NPM_HTTP_PORT=80             # Nginx Proxy Manager: el sitio con dominio
NPM_HTTPS_PORT=443
NPM_ADMIN_PORT=81            # su panel (solo en localhost)

# --- Correo ---
# MASTER SWITCH: en 0 no se envía NADA (queda en cola y registrado en EmailLog).
# Con EMAIL_HOST_PASSWORD definido va por SMTP real; sin él, a la consola.
SEND_EMAIL=0
DEFAULT_FROM_EMAIL=Frikiverso <no-reply@tudominio.com>
CONTACT_EMAIL=tu-correo@tudominio.com
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=tu-correo@gmail.com
EMAIL_HOST_PASSWORD=clave-de-aplicacion-de-gmail

# --- Celery ---
# El compose pone 1 en worker y beat (con redis). Aquí queda para el
# runserver local: 0 = las tareas corren síncronas, sin broker.
CELERY_ENABLED=0

# --- Estáticos / media ---
# USE_MANIFEST=1   # solo cuando TODOS los fondos del CSS existan (si no, revienta)
# USE_R2=0         # media SIEMPRE local; con 1 se SUBE a R2 (100/día) y la URL apunta allí (requiere django-storages + boto3)
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=
# R2_ENDPOINT_URL=
# R2_PUBLIC_DOMAIN=

# --- El día que haya servidor (aún no: sin dominio ni TLS) ---
# SECRET_KEY larga y aleatoria · ALLOWED_HOSTS con el dominio · DEV=0
# DB_PASSWORD fuerte · quitar DB_PORT_HOST (no publicar Postgres fuera)
# Con TLS delante: SECURE_SSL_REDIRECT=1 · SECURE_HSTS_SECONDS=31536000

